# Copy to .env and fill in real values. Without ANTHROPIC_API_KEY, every
# agent runs in deterministic mock mode (no network calls, no cost).

ANTHROPIC_API_KEY=

# Model selection
ZYNTH_MODEL_NAME=claude-sonnet-4-6
ZYNTH_FALLBACK_MODEL_NAME=claude-haiku-4-5-20251001

# Token / cost governance
ZYNTH_MAX_TOKENS_PER_CALL=4096
ZYNTH_MAX_TOKENS_PER_WORKFLOW=60000
ZYNTH_MAX_LLM_RETRIES=3
ZYNTH_MAX_JSON_REPAIR_ATTEMPTS=2
ZYNTH_REQUEST_TIMEOUT_SECONDS=60

# Orchestrator QA gate
ZYNTH_MAX_AGENT_RETRIES=2
ZYNTH_QA_MIN_PASS_SCORE=0.7

# Research/SEO tool integrations (leave blank to stay in mock mode)
SERPER_API_KEY=
SEMRUSH_API_KEY=
JINA_API_KEY=
ZYNTH_ALLOW_NETWORK=false

# Misc
ZYNTH_LOG_LEVEL=INFO
ZYNTH_OUTPUT_DIR=outputs
