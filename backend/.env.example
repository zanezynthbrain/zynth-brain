# Copy to .env and fill in real values.
# Without ANTHROPIC_API_KEY, every agent runs in deterministic mock mode.

ANTHROPIC_API_KEY=

# Model selection
ZYNTH_MODEL_NAME=claude-sonnet-4-6
ZYNTH_FALLBACK_MODEL_NAME=claude-haiku-4-5-20251001

# Token / cost governance
ZYNTH_MAX_TOKENS_PER_CALL=4096
ZYNTH_MAX_TOKENS_PER_WORKFLOW=60000
ZYNTH_MAX_LLM_RETRIES=3
ZYNTH_MAX_JSON_REPAIR_ATTEMPTS=2
ZYNTH_REQUEST_TIMEOUT_SECONDS=240

# Orchestrator QA gate
ZYNTH_MAX_AGENT_RETRIES=2
ZYNTH_QA_MIN_PASS_SCORE=0.7

# --- Telegram Bot (ZYNTH MD / @zynth_md_approval_bot) ---------------------
# Token: get from @BotFather → /newbot
# Chat IDs: run `python get_chat_id.py` after adding the bot to each group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=           # Your personal chat with the bot (CEO reports)

# Department group chat IDs (add the bot to each group first, then run get_chat_id.py)
TELEGRAM_BD_CHAT_ID=        # ZYNTH BD Department group
TELEGRAM_CREATIVE_CHAT_ID=  # ZYNTH Creative Department group
TELEGRAM_MARKETING_CHAT_ID= # ZYNTH Marketing Firm group
TELEGRAM_GM_CHAT_ID=        # ZYNTH GM / leadership group (create this new group)

# --- Scheduler / Timezone --------------------------------------------------
# Yangon is UTC+6:30 — this keeps all scheduled jobs on Myanmar time
ZYNTH_TIMEZONE=Asia/Rangoon
ZYNTH_BRIEF_HOUR=5
ZYNTH_BRIEF_MINUTE=30
ZYNTH_EOD_HOUR=18

# --- Storage (Google Drive) ------------------------------------------------
# Set to the folder ID from your Google Drive URL to enable auto-upload
# https://drive.google.com/drive/folders/<FOLDER_ID>
ZYNTH_GDRIVE_FOLDER_ID=

# --- Research/SEO APIs (leave blank to use mock mode) ----------------------
SERPER_API_KEY=
SEMRUSH_API_KEY=
JINA_API_KEY=
ZYNTH_ALLOW_NETWORK=false

# --- Cost governance -------------------------------------------------------
# Hard daily API spend cap in Singapore dollars.
# Bot halts LLM calls and alerts you on Telegram when this is reached.
ZYNTH_DAILY_BUDGET_SGD=5.0

# --- Business events -------------------------------------------------------
# ISO date of your next major ZYNTH event — countdown shown in every brief.
ZYNTH_IGNITE_DATE=2026-11-14
ZYNTH_IGNITE_NAME=IGNITE Summit

# --- Misc ------------------------------------------------------------------
ZYNTH_LOG_LEVEL=INFO
ZYNTH_OUTPUT_DIR=outputs
ZYNTH_AGENCY_NAME=ZYNTH

# --- Voice transcription (Telegram voice messages, MM + EN) ----------------
# Free API key from https://aistudio.google.com — leave blank to disable voice
GEMINI_API_KEY=
ZYNTH_TRANSCRIBE_MODEL=gemini-flash-latest

# --- Market FX fallback rates (MMK, "buy/sell") — /fx set overrides ---------
ZYNTH_FX_USD=4290/4400
ZYNTH_FX_SGD=3288/3380
ZYNTH_FX_THB=128.9/132.2

# --- Email channel (Google App Password: myaccount.google.com/apppasswords) -
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
ZYNTH_EMAIL_FROM=
SMTP_PASSWORD=
ZYNTH_EMAIL_TO=zane@zynth.asia
